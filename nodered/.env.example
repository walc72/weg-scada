# =============================================================================
# WEG SCADA - Environment Variables Template
# Copy this to .env and fill in your values
# =============================================================================

# Timezone
TZ=America/Mexico_City

# InfluxDB
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change-me
INFLUXDB_ORG=WEG_Monitoring
INFLUXDB_BUCKET=weg_drives
INFLUXDB_TOKEN=change-me
# Este token también se usa en el poller y la API (sobrescribe config.json)

# --- Retención y backups ---
# Retención del bucket (3 años). weg-backup la fija al arrancar; también aplica al init.
INFLUXDB_RETENTION=1095d
# Backup mensual (día 1, 03:00): carpeta local, rotación y guardián de disco
BACKUP_LOCAL_DIR=./backups
BACKUP_KEEP=12
DISK_FLOOR_GB=15
# Segundo destino (disco externo / carpeta de red): descomentar el volumen
# "<ruta>:/external" en el servicio backup del docker-compose y setear:
BACKUP_EXTERNAL=

# Grafana
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me

# SMTP (configure when needed)
GF_SMTP_USER=your-email@gmail.com
GF_SMTP_PASSWORD=your-app-password
GF_SMTP_FROM=your-email@gmail.com

# Alert notifications
ALERT_EMAIL=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Reporte diario automático (lo genera weg-api con el histórico de InfluxDB)
#   - Cada día a DAILY_REPORT_HOUR genera el PDF del día anterior en REPORTS_DIR
#   - Si hay SMTP (GF_SMTP_USER/PASSWORD) y un destinatario, lo envía por email
#   - Los PDF diarios se guardan en la carpeta REPORTS_DIR (por defecto ./reports)
DAILY_REPORT_ENABLED=true
DAILY_REPORT_HOUR=6
# Destinatario(s) del reporte diario (coma-separado). Vacío usa ALERT_EMAIL.
DAILY_REPORT_EMAIL=
# Carpeta local donde se acumulan los PDF diarios (host). Puede ser un disco/red.
REPORTS_DIR=./reports

# Tailscale (leave empty for manual auth)
TS_AUTHKEY=

# =============================================================================
# API Auth — dos roles: admin (todo, incl. Configuración) y operador (solo ve)
# =============================================================================
# Cada credencial admite password en texto plano o, PREFERIDO, hash scrypt.
# Generar un hash:  node scripts/hash-password.js 'tu-password'
#   -> imprime  scrypt$<salt>$<hash>  para poner en *_HASH (dejar el plano vacío)

# --- admin (acceso total) ---
AUTH_USER=admin
AUTH_PASSWORD=change-me
# AUTH_PASSWORD_HASH=scrypt$....   # si se define, ignora AUTH_PASSWORD

# --- operador (solo lectura: dashboards, históricos, reportes; sin Configuración) ---
# Dejar ambos vacíos para deshabilitar el rol operador.
OPERADOR_USER=operador
OPERADOR_PASSWORD=
# OPERADOR_PASSWORD_HASH=scrypt$....

# CORS: origen del frontend (p.ej. https://scada.midominio.com o * para dev)
ALLOWED_ORIGIN=*
